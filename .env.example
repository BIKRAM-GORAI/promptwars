# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/resolveai

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Storage Configuration
# Set STORAGE_TYPE to 'cloudinary' to use Cloudinary, otherwise defaults to 'local'
STORAGE_TYPE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP Configuration (Optional, logs to console if empty)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
EMAIL_FROM=noreply@resolveai.com

# Admin Authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
